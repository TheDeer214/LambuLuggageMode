# ⬜ Snippet 1: State Initialization and Floating Toggle Setup
import streamlit as st

st.set_page_config(page_title="Mobile LLM GUI", layout="centered")

# Initialize session state for toggling the GUI visibility
if "show_gui" not in st.session_state:
    st.session_state.show_gui = False

# Create a floating toggle mechanism using columns/sidebar for mobile friendliness
st.markdown("""
    <style>
        .floating-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
        }
    </style>
""", unsafe_allow_html=True)

# Toggle state button acting as the floating controller
with st.container():
    st.markdown('<div class="floating-container">', unsafe_allow_html=True)
    toggle_label = "❌ Close AI" if st.session_state.show_gui else "🤖 Open AI"
    if st.button(toggle_label, type="primary", use_container_width=False):
        st.session_state.show_gui = not st.session_state.show_gui
        st.rerun()
    st.markdown('</div>', unsafe_allow_html=True)
# ⬜ Snippet 2: Main Responsive LLM Chat Interface Logic
if st.session_state.show_gui:
    st.markdown("### 💬 Mobile LLM Chat Interface")
    
    # Initialize message history if it doesn't exist
    if "messages" not in st.session_state:
        st.session_state.messages = [
            {"role": "assistant", "content": "Hello! How can I help you today?"}
        ]

    # Display chat history containers (fully responsive for mobile screens)
    chat_container = st.container()
    with chat_container:
        for message in st.session_state.messages:
            with st.chat_message(message["role"]):
                st.markdown(message["content"])

    # Mobile-friendly chat input box at the bottom
    if prompt := st.chat_input("Type your message here..."):
        # Append user message
        st.session_state.messages.append({"role": "user", "content": prompt})
        with st.chat_message("user"):
            st.markdown(prompt)

        # Simulate assistant response pipeline
        with st.chat_message("assistant"):
            response_text = f"Echo: {prompt}"
            st.markdown(response_text)
            st.session_state.messages.append({"role": "assistant", "content": response_text})
